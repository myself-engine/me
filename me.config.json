{
  "dataDir": "~/.me",
  "plugins": [
    "plugins/slang",
    "plugins/summarize",
    "plugins/jev",
    "plugins/gjc-head",
    "plugins/brgr",
    "plugins/web",
    "plugins/approval-policy",
    "plugins/ops",
    "plugins/harness-config"
  ],
  "pluginConfig": {
    "gjc-head": {
      "model": "openai-codex/gpt-5.6-luna",
      "harnesses": [
        "local.claude-code",
        "local.codex",
        "local.gjc",
        "local.opencode"
      ],
      "simpleThreshold": 0.8,
      "defaultProject": "~/dev/me"
    },
    "summarize": {
      "model": "openai-codex/gpt-5.6-luna"
    },
    "jev": {
      "fallbackModel": "openai-codex/gpt-5.6-luna",
      "openrouterKeyFile": "~/.config/me/secrets/openrouter.key"
    },
    "brgr": {
      "harnesses": [
        "local.claude-code",
        "local.codex",
        "local.gjc",
        "local.opencode"
      ]
    },
    "web": {
      "port": 7420,
      "projects": [
        "~/dev/me"
      ],
      "defaultProject": "~/dev/me"
    },
    "approval-policy": {
      "rules": [
        {
          "name": "tests",
          "requester": "gjc-head",
          "payload": {
            "role": "test"
          }
        }
      ]
    },
    "ops": {
      "intervalSec": 60,
      "checks": [
        {
          "id": "me-web",
          "kind": "http",
          "url": "http://127.0.0.1:7420/",
          "expectStatus": 200
        }
      ],
      "startDelaySec": 5
    }
  }
}
