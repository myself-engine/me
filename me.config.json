{
  "dataDir": "~/.me",
  "plugins": [
    "plugins/slang",
    "plugins/summarize",
    "plugins/jev",
    "plugins/gjc-head",
    "plugins/brgr",
    "plugins/budget",
    "plugins/web",
    "plugins/approval-policy",
    "plugins/ops",
    "plugins/schedule",
    "plugins/harness-config"
  ],
  "pluginConfig": {
    "gjc-head": {
      "harness": "gjc",
      "model": "openai-codex/gpt-5.6-luna",
      "models": { "gjc": "openai-codex/gpt-5.6-luna", "omp": "openai-codex/gpt-5.6-luna" },
      "fallbackModels": ["opencode-go/deepseek-v4.1-flash"],
      "favoriteModels": ["openai-codex/gpt-6.1-sol", "openai-codex/gpt-6-luna"],
      "workerModels": {
        "local.claude-code": ["opus", "sonnet"],
        "local.codex": ["gpt-6.1-sol", "gpt-6-luna"],
        "local.gjc": ["openai-codex/gpt-6.1-sol", "openai-codex/gpt-6-luna"]
      },
      "harnesses": [
        "local.claude-code",
        "local.codex",
        "local.gjc",
        "local.opencode"
      ],
      "simpleThreshold": 0.8,
      "defaultProject": "~/dev/me"
    },
    "summarize": {
      "harness": "gjc",
      "model": "openai-codex/gpt-5.6-luna"
    },
    "jev": {
      "harness": "gjc",
      "fallbackModel": "openai-codex/gpt-5.6-luna",
      "openrouterKeyFile": "~/.config/me/secrets/openrouter.key", "jevModel": "~typesafe/jev-latest"
    },
    "brgr": {
      "harnesses": [
        "local.claude-code",
        "local.codex",
        "local.gjc",
        "local.opencode"
      ]
    },
    "web": {
      "port": 7420,
      "projects": [
        "~/dev/me"
      ],
      "defaultProject": "~/dev/me"
    },
    "approval-policy": {
      "rules": [
        {
          "name": "tests",
          "requester": "gjc-head",
          "payload": {
            "role": "test"
          }
        }
      ]
    },
    "budget": {
      "dailyCap": 30,
      "autoApplyCap": 10,
      "minRemainingPercent": 10,
      "hardStopPercent": 3,
      "providers": { "local.codex": "codex", "local.claude-code": "claude" },
      "opencodeModelPrefix": "opencode-go",
      "opencodeProvider": "opencode-go",
      "meterTimeoutMs": 5000,
      "cacheSec": 60
    },
    "ops": {
      "intervalSec": 60,
      "checks": [
        {
          "id": "me-web",
          "kind": "http",
          "url": "http://127.0.0.1:7420/",
          "expectStatus": 200
        }
      ],
      "startDelaySec": 5
    },
    "schedule": {
      "allowUnattendedWrite": false,
      "jobs": []
    }
  }
}
