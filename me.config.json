{
  "dataDir": "~/.me",
  "plugins": [
    "plugins/slang",
    "plugins/summarize",
    "plugins/jev",
    "plugins/gjc-head",
    "plugins/brgr",
    "plugins/web"
  ],
  "pluginConfig": {
    "gjc-head": {
      "model": "openai-codex/gpt-5.6-luna",
      "harnesses": ["local.claude-code", "local.codex", "local.gjc", "local.opencode"],
      "simpleThreshold": 0.8,
      "defaultProject": "~/dev/me"
    },
    "summarize": { "model": "openai-codex/gpt-5.6-luna" },
    "jev": { "fallbackModel": "openai-codex/gpt-5.6-luna", "openrouterKeyFile": "~/.config/me/secrets/openrouter.key" },
    "brgr": { "harnesses": ["local.claude-code", "local.codex", "local.gjc", "local.opencode"] },
    "web": { "port": 7420, "projects": ["~/dev/me"], "defaultProject": "~/dev/me" }
  }
}
