{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ]
  },
  "include": [
    "protocol",
    "kernel",
    "sdk",
    "lib",
    "plugins",
    "bin",
    "scripts",
    "bridges",
    "tools",
    "spec"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
