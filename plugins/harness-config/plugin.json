{
  "id": "harness-config",
  "version": "0.1.0",
  "protocol": { "min": 1, "max": 1 },
  "run": { "command": ["bun", "src/main.ts"] },
  "permissions": ["read-state", "emit"],
  "provides": {
    "methods": ["plan", "apply", "import", "list"],
    "events": ["harness-config.applied"]
  },
  "restart": { "policy": "on-failure", "maxRestarts": 5, "windowSec": 300 }
}
