{
  "id": "web",
  "version": "0.1.0",
  "protocol": { "min": 1, "max": 1 },
  "run": { "command": ["bun", "src/server.ts"] },
  "permissions": [
    "read-state",
    "subscribe",
    "call:gjc-head",
    "call:brgr",
    "call:slang",
    "call:ops",
    "call:ops-*",
    "approve.decide",
    "journal.read",
    "network",
    "shell"
  ],
  "provides": { "methods": [], "kinds": ["settings"] },
  "subscribes": ["kernel.*", "gjc-head.*", "brgr.*"],
  "restart": { "policy": "on-failure", "maxRestarts": 5, "windowSec": 300 }
}
