{
  "id": "watch",
  "version": "0.1.0",
  "protocol": { "min": 1, "max": 1 },
  "run": { "command": ["bun", "src/main.ts"] },
  "permissions": ["read-state", "emit", "shell"],
  "provides": {
    "methods": ["watch.list", "watch.get"],
    "events": ["watch.stalled"],
    "kinds": ["agent", "status"]
  },
  "restart": { "policy": "on-failure", "maxRestarts": 5, "windowSec": 300 }
}
