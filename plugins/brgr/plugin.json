{
  "id": "brgr",
  "version": "0.1.0",
  "protocol": { "min": 1, "max": 1 },
  "run": { "command": ["bun", "src/main.ts"] },
  "permissions": ["read-state", "emit", "shell"],
  "provides": {
    "methods": ["task.delegate", "task.result", "task.diff", "task.accept", "task.reject", "task.cancel", "harness.list"],
    "events": ["brgr.task.running", "brgr.task.sealed", "brgr.task.failed", "brgr.task.awaiting-input", "brgr.task.accepted", "brgr.task.rejected"],
    "kinds": ["task"]
  },
  "restart": { "policy": "on-failure", "maxRestarts": 5, "windowSec": 300 }
}
