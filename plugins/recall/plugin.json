{
  "id": "recall",
  "version": "0.1.0",
  "protocol": { "min": 1, "max": 1 },
  "run": { "command": ["bun", "src/main.ts"] },
  "permissions": ["read-state", "write-state:recall.fact"],
  "provides": { "methods": ["recall.search", "recall.status", "recall.remember", "recall.forget", "recall.facts", "recall.context"], "kinds": ["fact"] },
  "subscribes": [],
  "restart": { "policy": "on-failure", "maxRestarts": 5, "windowSec": 300 }
}
