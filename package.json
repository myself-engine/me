{
  "name": "me",
  "private": true,
  "type": "module",
  "workspaces": [
    "protocol",
    "kernel",
    "sdk",
    "lib/*",
    "plugins/*",
    "bridges/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "start": "bun bin/me.ts start me.config.json",
    "e2e": "bun scripts/e2e.ts",
    "shots": "bun scripts/shots.ts",
    "a11y": "bun scripts/a11y.ts",
    "release": "bun bin/me.ts release"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.6.3",
    "@me/kernel": "workspace:*",
    "@me/sdk": "workspace:*",
    "@me/protocol": "workspace:*",
    "axe-core": "4.13.0"
  },
  "bin": {
    "me": "bin/me.ts"
  }
}
