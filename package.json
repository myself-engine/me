{
  "name": "myself-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "protocol",
    "kernel",
    "sdk",
    "lib/*",
    "plugins/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "start": "bun run kernel/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.6.3",
    "@myself/kernel": "workspace:*",
    "@myself/sdk": "workspace:*",
    "@myself/protocol": "workspace:*"
  }
}
