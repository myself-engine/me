{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://me.local/spec/protocol.schema.json",
  "title": "me plugin protocol",
  "description": "Language-neutral source of the me plugin protocol (docs/PROTOCOL.md). Every $defs key is the type name used by generated bindings. x-tsType overrides the TypeScript rendering where JSON Schema cannot express the TS type exactly.",
  "x-protocolVersion": 1,
  "x-errorCodes": {
    "PermissionDenied": -32001,
    "TargetUnavailable": -32002,
    "Timeout": -32003,
    "Cancelled": -32004,
    "ProtocolMismatch": -32005,
    "SchemaViolation": -32006
  },
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "RpcId": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "RpcErrorObject": {
      "description": "JSON-RPC error object (§1, §11).",
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/JsonValue"
        }
      }
    },
    "RpcRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/RpcId"
        },
        "method": {
          "type": "string"
        },
        "params": {}
      }
    },
    "RpcNotification": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "type": "string"
        },
        "params": {}
      },
      "not": {
        "required": [
          "id"
        ]
      }
    },
    "RpcSuccess": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/RpcId"
        },
        "result": {}
      }
    },
    "RpcFailure": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RpcId"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/RpcErrorObject"
        }
      }
    },
    "RpcFrame": {
      "description": "One NDJSON line.",
      "anyOf": [
        {
          "$ref": "#/$defs/RpcRequest"
        },
        {
          "$ref": "#/$defs/RpcNotification"
        },
        {
          "$ref": "#/$defs/RpcSuccess"
        },
        {
          "$ref": "#/$defs/RpcFailure"
        }
      ]
    },
    "PluginId": {
      "description": "Plugin ids are lowercase kebab-case; they are also the event/kind namespace.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "Permission": {
      "x-tsType": "\"read-state\" | `write-state:${string}` | \"emit\" | \"subscribe\" | `call:${PluginId}` | \"call:*\" | \"approve.request\" | \"approve.decide\" | \"journal.read\" | \"shell\" | \"network\"",
      "anyOf": [
        {
          "enum": [
            "read-state",
            "emit",
            "subscribe",
            "call:*",
            "approve.request",
            "approve.decide",
            "journal.read",
            "shell",
            "network"
          ]
        },
        {
          "type": "string",
          "pattern": "^write-state:[a-z0-9.-]+$"
        },
        {
          "type": "string",
          "pattern": "^call:[a-z][a-z0-9-]*(-\\*)?$"
        }
      ]
    },
    "Manifest": {
      "description": "plugin.json (§2). Read by the kernel before the plugin process starts.",
      "type": "object",
      "required": [
        "id",
        "version",
        "protocol",
        "run",
        "permissions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/PluginId"
        },
        "version": {
          "type": "string"
        },
        "protocol": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          }
        },
        "run": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "cwd": {
              "type": "string"
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "envPass": {
              "description": "Extra parent env names kept for the plugin process: exact names or PREFIX_* globs. No \"*\" wildcard.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Permission"
          }
        },
        "provides": {
          "type": "object",
          "properties": {
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "events": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kinds": {
              "description": "Entity kinds this plugin owns, without the namespace prefix.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "allowWriters": {
          "description": "Other plugins allowed to write a kind this plugin owns: { kind: [pluginId] }.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PluginId"
            }
          }
        },
        "subscribes": {
          "description": "Event name patterns, `*` matches one or more trailing segments.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restart": {
          "type": "object",
          "required": [
            "policy",
            "maxRestarts",
            "windowSec"
          ],
          "properties": {
            "policy": {
              "enum": [
                "never",
                "on-failure",
                "always"
              ]
            },
            "maxRestarts": {
              "type": "integer"
            },
            "windowSec": {
              "type": "integer"
            }
          }
        }
      }
    },
    "FrameContext": {
      "description": "Context attached by the kernel to everything it forwards (§4, §6, §10).",
      "type": "object",
      "required": [
        "seq",
        "traceId",
        "causationId",
        "source",
        "ts"
      ],
      "properties": {
        "seq": {
          "description": "Global journal sequence number of this frame.",
          "type": "integer"
        },
        "traceId": {
          "description": "Groups everything started by one user turn.",
          "type": "string"
        },
        "causationId": {
          "description": "seq of the journal entry that directly caused this one, if any.",
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginId"
            },
            {
              "const": "kernel"
            }
          ]
        },
        "ts": {
          "description": "ISO 8601",
          "type": "string"
        }
      }
    },
    "HelloParams": {
      "description": "Plugin → kernel request `hello`: the first frame on a connect-in socket (exec mode B, §1, §3).",
      "type": "object",
      "required": [
        "manifest",
        "token"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "token": {
          "description": "Contents of $ME_HOME/connect.token.",
          "type": "string"
        }
      }
    },
    "HelloResult": {
      "type": "object",
      "required": [
        "protocolVersion",
        "grantedPermissions"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer"
        },
        "grantedPermissions": {
          "description": "Declared permissions intersected with the kernel's connectPermissions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Permission"
          }
        }
      }
    },
    "InitializeParams": {
      "description": "Kernel → plugin request `initialize` (§3).",
      "type": "object",
      "required": [
        "protocolVersion",
        "pluginId",
        "grantedPermissions",
        "config"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer"
        },
        "pluginId": {
          "$ref": "#/$defs/PluginId"
        },
        "grantedPermissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Permission"
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      }
    },
    "InitializeResult": {
      "type": "object",
      "required": [
        "protocolVersion",
        "ready"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer"
        },
        "ready": {
          "const": true
        }
      }
    },
    "ShutdownParams": {
      "description": "Kernel → plugin request `shutdown`. The plugin answers, then exits within 5s.",
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "user",
            "restart",
            "kernel-exit",
            "quarantine"
          ]
        }
      }
    },
    "CallParams": {
      "description": "Kernel → plugin request `call`: a call routed to the plugin that provides `method`.",
      "type": "object",
      "required": [
        "method",
        "params",
        "stream",
        "ctx"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "params": {},
        "stream": {
          "type": "boolean"
        },
        "opId": {
          "description": "Present when stream is true; the callee reports progress against it.",
          "type": "string"
        },
        "ctx": {
          "allOf": [
            {
              "$ref": "#/$defs/FrameContext"
            },
            {
              "type": "object",
              "required": [
                "caller"
              ],
              "properties": {
                "caller": {
                  "$ref": "#/$defs/PluginId"
                }
              }
            }
          ]
        }
      }
    },
    "EventParams": {
      "description": "Kernel → plugin notification `event` (§6).",
      "type": "object",
      "required": [
        "name",
        "data",
        "ctx"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "data": {},
        "ctx": {
          "$ref": "#/$defs/FrameContext"
        }
      }
    },
    "KernelToPlugin": {
      "description": "Frames the kernel sends to a plugin, keyed by method.",
      "type": "object",
      "required": [
        "initialize",
        "shutdown",
        "call",
        "event",
        "op.update",
        "op.end",
        "op.cancel"
      ],
      "properties": {
        "initialize": {
          "allOf": [
            {
              "$ref": "#/$defs/RpcRequest"
            },
            {
              "type": "object",
              "required": [
                "method",
                "params"
              ],
              "properties": {
                "method": {
                  "const": "initialize"
                },
                "params": {
                  "$ref": "#/$defs/InitializeParams"
                }
              }
            }
          ]
        },
        "shutdown": {
          "allOf": [
            {
              "$ref": "#/$defs/RpcRequest"
            },
            {
              "type": "object",
              "required": [
                "method",
                "params"
              ],
              "properties": {
                "method": {
                  "const": "shutdown"
                },
                "params": {
                  "$ref": "#/$defs/ShutdownParams"
                }
              }
            }
          ]
        },
        "call": {
          "allOf": [
            {
              "$ref": "#/$defs/RpcRequest"
            },
            {
              "type": "object",
              "required": [
                "method",
                "params"
              ],
              "properties": {
                "method": {
                  "const": "call"
                },
                "params": {
                  "$ref": "#/$defs/CallParams"
                }
              }
            }
          ]
        },
        "event": {
          "allOf": [
            {
              "$ref": "#/$defs/RpcNotification"
            },
            {
              "type": "object",
              "required": [
                "method",
                "params"
              ],
              "properties": {
                "method": {
                  "const": "event"
                },
                "params": {
                  "$ref": "#/$defs/EventParams"
                }
              }
            }
          ]
        },
        "op.update": {
          "allOf": [
            {
              "$ref": "#/$defs/RpcNotification"
            },
            {
              "type": "object",
              "required": [
                "method",
                "params"
              ],
              "properties": {
                "method": {
                  "const": "op.update"
                },
                "params": {
                  "$ref": "#/$defs/OpUpdateParams"
                }
              }
            }
          ]
        },
        "op.end": {
          "allOf": [
            {
              "$ref": "#/$defs/RpcNotification"
            },
            {
              "type": "object",
              "required": [
                "method",
                "params"
              ],
              "properties": {
                "method": {
                  "const": "op.end"
                },
                "params": {
                  "$ref": "#/$defs/OpEndParams"
                }
              }
            }
          ]
        },
        "op.cancel": {
          "allOf": [
            {
              "$ref": "#/$defs/RpcNotification"
            },
            {
              "type": "object",
              "required": [
                "method",
                "params"
              ],
              "properties": {
                "method": {
                  "const": "op.cancel"
                },
                "params": {
                  "$ref": "#/$defs/OpRefParams"
                }
              }
            }
          ]
        }
      }
    },
    "InvokeParams": {
      "description": "Plugin → kernel request `invoke` (§4, §5).",
      "type": "object",
      "required": [
        "target",
        "method",
        "params"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/PluginId"
        },
        "method": {
          "type": "string"
        },
        "params": {},
        "stream": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer"
        },
        "traceId": {
          "description": "Omit to start a new trace (only plugins that receive user input should).",
          "type": "string"
        },
        "causationId": {
          "description": "seq of the frame being handled when this call was made; the SDK fills it in.",
          "type": "integer"
        }
      }
    },
    "InvokeResult": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {}
          }
        },
        {
          "type": "object",
          "required": [
            "opId"
          ],
          "properties": {
            "opId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "OpUpdateParams": {
      "type": "object",
      "required": [
        "opId",
        "update"
      ],
      "properties": {
        "opId": {
          "type": "string"
        },
        "update": {}
      }
    },
    "OpEndParams": {
      "description": "Ends a streaming op. Exactly one op.end is sent per opId.",
      "type": "object",
      "required": [
        "opId"
      ],
      "properties": {
        "opId": {
          "type": "string"
        },
        "result": {},
        "error": {
          "$ref": "#/$defs/RpcErrorObject"
        }
      }
    },
    "OpRefParams": {
      "description": "Params of op.cancel and op.subscribe.",
      "type": "object",
      "required": [
        "opId"
      ],
      "properties": {
        "opId": {
          "type": "string"
        }
      }
    },
    "EmitParams": {
      "description": "Plugin → kernel request `emit` (§6).",
      "type": "object",
      "required": [
        "name",
        "data"
      ],
      "properties": {
        "name": {
          "description": "Must start with `<own plugin id>.`.",
          "type": "string"
        },
        "data": {},
        "traceId": {
          "type": "string"
        },
        "causationId": {
          "type": "integer"
        }
      }
    },
    "SubscribeParams": {
      "type": "object",
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "description": "Same pattern syntax as Manifest.subscribes.",
          "type": "string"
        }
      }
    },
    "EntityRegisterKindParams": {
      "type": "object",
      "required": [
        "kind",
        "schema"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/JsonValue"
        }
      }
    },
    "EntityUpsertParams": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "data"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/JsonValue"
        }
      }
    },
    "EntityGetParams": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "EntityDoc": {
      "description": "§7",
      "type": "object",
      "required": [
        "kind",
        "id",
        "data",
        "updatedSeq"
      ],
      "properties": {
        "kind": {
          "description": "namespaced, e.g. \"brgr.task\"",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "data": {},
        "updatedSeq": {
          "type": "integer"
        }
      }
    },
    "EntityListParams": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "where": {
          "description": "Top-level field equality only.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "limit": {
          "type": "integer"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "Risk": {
      "description": "§9",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "ApprovalRequestParams": {
      "type": "object",
      "required": [
        "summary",
        "risk"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        },
        "expiresInSec": {
          "type": "integer"
        }
      }
    },
    "ApprovalDecision": {
      "type": "object",
      "required": [
        "decision"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "note": {
          "type": "string"
        },
        "amend": {
          "description": "Changes the decider made to the request's payload (e.g. a different harness). Only meaningful on approve.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      }
    },
    "ApprovalDecideParams": {
      "allOf": [
        {
          "$ref": "#/$defs/ApprovalDecision"
        },
        {
          "type": "object",
          "required": [
            "approvalId"
          ],
          "properties": {
            "approvalId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ApprovalListParams": {
      "type": "object",
      "additionalProperties": false
    },
    "JournalQueryParams": {
      "description": "§10",
      "type": "object",
      "required": [
        "limit"
      ],
      "properties": {
        "traceId": {
          "type": "string"
        },
        "sinceSeq": {
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginId"
            },
            {
              "const": "kernel"
            }
          ]
        },
        "limit": {
          "type": "integer"
        }
      }
    },
    "JournalEntry": {
      "type": "object",
      "required": [
        "seq",
        "ts",
        "source",
        "traceId",
        "causationId",
        "type",
        "body"
      ],
      "properties": {
        "seq": {
          "type": "integer"
        },
        "ts": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginId"
            },
            {
              "const": "kernel"
            }
          ]
        },
        "traceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "causationId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "type": {
          "enum": [
            "call",
            "result",
            "error",
            "event",
            "op.update",
            "op.end",
            "approval",
            "permission.denied",
            "lifecycle"
          ]
        },
        "body": {
          "$ref": "#/$defs/JsonValue"
        }
      }
    },
    "PluginToKernel": {
      "description": "Frames a plugin sends to the kernel, keyed by method. Kernel methods are called directly; plugin methods go through `invoke`.",
      "type": "object",
      "required": [
        "hello",
        "invoke",
        "op.update",
        "op.end",
        "op.subscribe",
        "op.cancel",
        "emit",
        "subscribe",
        "entity.registerKind",
        "entity.upsert",
        "entity.get",
